<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Kannur TVS – Test Ride & Exchange</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--red:#a50f1b;--red-d:#2a050a;--gold:#ffc928;--bg:#fbf7f4;--card:#fff;--ink:#241618;--mute:#6b5a5c;--line:#eadfdc;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#160709;--card:#220c10;--ink:#f6ebe8;--mute:#b9a3a5;--line:#3a1a1f}}
:root[data-theme="dark"]{--bg:#160709;--card:#220c10;--ink:#f6ebe8;--mute:#b9a3a5;--line:#3a1a1f}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.6 Barlow,system-ui,sans-serif}
h1,h2,h3{font-family:'Barlow Condensed',Impact,sans-serif;line-height:1.02;margin:0;font-weight:800;letter-spacing:.2px}
a{color:inherit}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
.btn{display:inline-flex;align-items:center;gap:10px;font:700 20px 'Barlow Condensed',sans-serif;letter-spacing:.5px;text-decoration:none;padding:15px 28px;border-radius:999px;border:2px solid transparent;cursor:pointer}
.btn-call{background:var(--gold);color:#2a050a}
.btn-call:hover{background:#ffd957}
.btn-ghost{border-color:rgba(255,255,255,.55);color:#fff}
.btn:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #fff;outline-offset:3px;box-shadow:0 0 0 6px var(--red)}
/* top bar */
.top{background:var(--red-d);color:#fff}
.top .wrap{display:flex;justify-content:space-between;align-items:center;height:64px}
.brand{font:800 26px 'Barlow Condensed',sans-serif;letter-spacing:1px}
.brand small{font:500 12px Barlow,sans-serif;display:block;opacity:.7;letter-spacing:.3px;margin-top:-3px}
.top a.tel{font:700 20px 'Barlow Condensed',sans-serif;text-decoration:none;color:var(--gold)}
/* hero */
.hero{background:radial-gradient(120% 90% at 50% 100%,#d1202e 0%,var(--red) 38%,var(--red-d) 100%);color:#fff;text-align:center;overflow:hidden}
.hero .txt{padding:56px 20px 8px;max-width:760px;margin:0 auto}
.hero h1{font-size:clamp(44px,9vw,84px);text-transform:uppercase}
.hero p{font-size:19px;opacity:.92;margin:16px auto 28px;max-width:520px}
.hero .cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.hero .note{font-size:14px;opacity:.75;margin-top:14px}
.hero img{display:block;width:100%;max-width:1000px;margin:18px auto 0;-webkit-mask-image:linear-gradient(to bottom,transparent 0,#000 22%);mask-image:linear-gradient(to bottom,transparent 0,#000 22%)}
/* sections */
section{padding:72px 0}
h2{font-size:clamp(34px,5.5vw,52px);margin-bottom:14px}
.about{display:grid;grid-template-columns:1.05fr 1fr;gap:44px;align-items:center}
.about img{width:100%;border-radius:18px;display:block}
.about p{color:var(--mute);margin:0 0 14px}
.stats{display:flex;gap:28px;margin-top:22px;flex-wrap:wrap}
.stats b{font:800 38px 'Barlow Condensed',sans-serif;color:var(--red);display:block;line-height:1}
.stats span{font-size:14px;color:var(--mute)}
@media (prefers-color-scheme:dark){.stats b{color:var(--gold)}}
.services{background:var(--card);border-block:1px solid var(--line)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:18px;margin-top:30px}
.svc{padding:24px;border:1px solid var(--line);border-radius:14px;background:var(--bg)}
.svc svg{width:34px;height:34px;stroke:var(--red);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;margin-bottom:12px}
@media (prefers-color-scheme:dark){.svc svg{stroke:var(--gold)}}
.svc h3{font-size:26px;margin-bottom:6px}
.svc p{margin:0;color:var(--mute);font-size:15.5px}
/* form */
.lead{background:linear-gradient(160deg,var(--red) 0%,var(--red-d) 100%);color:#fff}
.lead .wrap{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center}
.lead p{opacity:.9}
.lead .big{font:800 clamp(34px,6vw,52px) 'Barlow Condensed',sans-serif;color:var(--gold);text-decoration:none;display:block;margin-top:10px}
form{background:#fff;color:#241618;padding:28px;border-radius:18px;display:grid;gap:14px}
label{font:600 14px Barlow,sans-serif}
input,select{width:100%;margin-top:5px;padding:13px 14px;font:inherit;border:1.5px solid #d9cbc8;border-radius:10px;background:#fff;color:#241618}
form .btn{justify-content:center;width:100%}
.ok{display:none;text-align:center;padding:30px 10px}
.ok h3{font-size:34px;color:var(--red)}
/* footer */
footer{background:#120406;color:#cdb9ba;padding:44px 0 96px;font-size:15px}
footer .wrap{display:flex;gap:30px;justify-content:space-between;flex-wrap:wrap}
footer b{color:#fff;font:700 24px 'Barlow Condensed',sans-serif;letter-spacing:.5px;display:block;margin-bottom:6px}
footer a{color:var(--gold);text-decoration:none}
.sticky{position:fixed;left:0;right:0;bottom:0;display:none;z-index:9;padding:10px 14px calc(10px + env(safe-area-inset-bottom,0px));background:rgba(18,4,6,.94)}
.sticky .btn{width:100%;justify-content:center}
@media (max-width:760px){.about,.lead .wrap{grid-template-columns:1fr}.sticky{display:block}.top a.tel{display:none}section{padding:52px 0}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style></head><body>
<header class="top"><div class="wrap"><div class="brand">KANNUR TVS<small>Authorised Main Dealer – TVS Motor Company</small></div><a class="tel" href="tel:+917736360444">Call 7736 360 444</a></div></header>

